{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "normalizer": {
        "lowercase_ascii": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "app_id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "english",
        "fields": {
          "keyword": { "type": "keyword", "normalizer": "lowercase_ascii", "ignore_above": 256 },
          "suggest": { "type": "search_as_you_type" }
        }
      },
      "short_description": { "type": "text", "analyzer": "english" },
      "description": { "type": "text", "analyzer": "english" },
      "genres": { "type": "keyword" },
      "tags": {
        "type": "keyword",
        "fields": {
          "text": { "type": "text", "analyzer": "english" }
        }
      },
      "developer": {
        "type": "keyword",
        "fields": {
          "text": { "type": "text" }
        }
      },
      "price": { "type": "scaled_float", "scaling_factor": 100 },
      "is_free": { "type": "boolean" },
      "release_date": { "type": "date", "format": "yyyy-MM-dd" },
      "release_year": { "type": "integer" },
      "review_score": { "type": "integer" },
      "review_count": { "type": "integer" },
      "header_image": { "type": "keyword", "index": false, "doc_values": false },
      "review_snippets": { "type": "text", "analyzer": "english" },
      "description_vector": { "type": "dense_vector", "dims": 384, "index": true, "similarity": "cosine" },
      "review_vector": { "type": "dense_vector", "dims": 384, "index": true, "similarity": "cosine" }
    }
  }
}
